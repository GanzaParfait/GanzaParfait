{
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "princeparfait.com" }],
      "destination": "https://www.princeparfait.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "princeparfait.com" }],
      "destination": "https://www.princeparfait.com/:path*",
      "permanent": true
    }
  ]
}
