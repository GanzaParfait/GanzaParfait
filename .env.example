# =============================================================================
# Prince Parfait GANZA — environment template
# Copy to `.env.local` and fill values. Never commit filled secrets.
# Production: Vercel → Project → Settings → Environment Variables
# =============================================================================

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://www.princeparfait.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS=true

# --- Supabase (auth, settings, subscribers, media storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (optional media CDN / uploads; keep even if unused yet) ---
# Used when media should be served or uploaded through Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_UPLOAD_PRESET=

# --- Dashboard login (/api/auth/login) ---
ADMIN_EMAIL=you@princeparfait.com
ADMIN_PASSWORD=

# --- Outbound mailbox addresses (From / Reply-To) ---
EMAIL_NOREPLY=noreply@princeparfait.com
EMAIL_HELLO=hello@princeparfait.com
EMAIL_THANKS=thanks@princeparfait.com
EMAIL_CONTACT=contact@princeparfait.com
EMAIL_REPLY_TO=hello@princeparfait.com

# Optional secret for /email-preview in production (?key=...)
EMAIL_PREVIEW_KEY=

# --- Mail transport: Resend OR SMTP ---
RESEND_API_KEY=

# Namecheap / cPanel SMTP (smtp_namecheap.txt)
SMTP_HOST=princeparfait.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@princeparfait.com
SMTP_PASS=

SMTP_THANKS_USER=thanks@princeparfait.com
SMTP_THANKS_PASS=
SMTP_CONTACT_USER=contact@princeparfait.com
SMTP_CONTACT_PASS=
SMTP_HELLO_USER=hello@princeparfait.com
SMTP_HELLO_PASS=
